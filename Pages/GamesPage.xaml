<UserControl x:Class="FrameForge.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/HyperCore;component/FfTheme.xaml"/>
    </UserControl.Resources>
    <Grid Margin="32,4,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Adicionar .exe" Style="{StaticResource Btn}" Click="Add_Click"/>
                    <Button Content="Procurar de novo" Style="{StaticResource Btn}" Click="Rescan_Click"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FfCard}" Padding="6" Margin="0">
            <DockPanel>
                <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="6,6,6,8" TextChanged="Search_Changed" ToolTip="Procurar"/>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" SelectionChanged="List_Changed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Detail">
                <TextBlock Text="A procurar jogos instalados…" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
