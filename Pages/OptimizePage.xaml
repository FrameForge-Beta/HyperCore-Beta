<UserControl x:Class="FrameForge.Pages.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/FrameForge;component/FfTheme.xaml"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,40">
            <TextBlock Text="Otimização do Windows" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,16"
                       Text="Escolhe um nível. Cada ajuste diz o ganho REAL esperado e quando não o usar. Tudo guarda o valor original e volta atrás com 'Restaurar tudo'. Nada aqui desliga segurança (Defender, UAC, Windows Update, VBS)."/>
            <Border Style="{StaticResource FfCard}">
                <StackPanel>
                    <TextBlock Text="Nível de desempenho" Style="{StaticResource H2}"/>
                    <WrapPanel x:Name="Levels" Margin="0,4,0,8"/>
                    <TextBlock x:Name="LevelText" Style="{StaticResource Body}" Margin="0,4,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ApplyBtn" Content="Aplicar este nível" Style="{StaticResource BtnAccent}" Click="Apply_Click"/>
                        <Button Content="Restaurar tudo" Style="{StaticResource BtnDanger}" Click="Restore_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="Result" Style="{StaticResource MutedAuto}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Ajustes individuais" Style="{StaticResource H2}" Margin="0,8,0,8"/>
            <StackPanel x:Name="List"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
