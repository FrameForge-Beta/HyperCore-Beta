<Project Sdk="Microsoft.NET.Sdk">

  <!-- HyperCore (antigo FrameForge): aplicação Windows para monitorização, diagnóstico e desempenho em jogos. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>HyperCore</AssemblyName>
    <RootNamespace>HyperCore</RootNamespace>
    <Product>HyperCore</Product>
    <Version>0.5.1</Version>
    <FileVersion>0.5.1</FileVersion>
    <AssemblyVersion>0.5.1</AssemblyVersion>
    <!-- Sempre otimizado: benchmarks e stress tests precisam do JIT otimizado -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8602;CS8604;CS8618;CS0168;CS0219</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);publicar\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo-dark.png" />
    <Resource Include="Assets\logo-badge.png" />
  </ItemGroup>

  <!-- Drivers seriais oficiais embutidos para ferramentas Maker -->
  <ItemGroup>
    <EmbeddedResource Include="Drivers\**\*" Exclude="Drivers\*.md;Drivers\*.txt" LogicalName="Drivers/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Índice de desempenho e preços de referência (upgrades), versionado e datado -->
  <ItemGroup>
    <EmbeddedResource Include="Data\perf-index.json" LogicalName="Data/perf-index.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Native\iCUESDK.x64_2019.dll" Condition="Exists('Native\iCUESDK.x64_2019.dll')" Link="iCUESDK.x64_2019.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>

</Project>
